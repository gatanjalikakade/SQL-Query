SQL> 
SQL> --1] WRITE A QUERY TO DISPLAY DEPARTMENT NUMBER AND NUMBER OF EMPLOYEES WHO WORKING IN EACH DEPARTMENT IF THERE ARE ATLEAST 2 CLEARKS IN EACH DEPARTMENT ?
SQL> 
SQL> SELECT COUNT(*), DEPTNO
  2  FROM EMP
  3  WHERE JOB='CLERK'
  4  GROUP BY DEPTNO
  5  HAVING COUNT(*) >=2;

  COUNT(*)     DEPTNO                                                           
---------- ----------                                                           
         2         20                                                           

SQL> 
SQL> -----------------------------------------------------------------------------------------------
SQL> 
SQL> --2] WRITE A QUERY TO DISPLAY DEPARTMENT NUMBER AND TOTAL SALARY NEEDED TO PAY ALL EMPLOYEE IN EACH DEPT IF THERE ARE ATLEAST 4 EMPLOYEE IN EACH DEPARTMENT ?
SQL> 
SQL> SELECT SUM(SAL), DEPTNO, COUNT(*)
  2  FROM EMP
  3  GROUP BY DEPTNO
  4  HAVING COUNT(*) >=4;

  SUM(SAL)     DEPTNO   COUNT(*)                                                
---------- ---------- ----------                                                
      9400         30          6                                                
     10875         20          5                                                

SQL> 
SQL> -----------------------------------------------------------------------------------------------
SQL> 
SQL> 
SQL> --3] WRITE A QUERY TO DISPLAY NUMBER OF EMPLOYEE EARNING SALARY MORE THAN 1200 IN EACH JOB AND THE TOTAL SALARY NEEDED TO PAY EMPLOYEE OF EACH JOB MUST EXCEES 3800 ?
SQL> 
SQL> SELET COUNT(*), SUM(SAL), JOB
SP2-0734: unknown command beginning "SELET COUN..." - rest of line ignored.
SQL> 
SQL> SELECT  COUNT(*), SUM(SAL), JOB
  2  FROM EMP
  3  WHERE SAL > 1200
  4  GROUP BY JOB
  5  HAVING SUM(SAL) >3800;

  COUNT(*)   SUM(SAL) JOB                                                       
---------- ---------- ---------                                                 
         4       5600 SALESMAN                                                  
         1       5000 PRESIDENT                                                 
         3       8275 MANAGER                                                   
         2       6000 ANALYST                                                   

SQL> 
SQL> 
SQL> -----------------------------------------------------------------------------------------------
