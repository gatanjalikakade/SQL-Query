SQL> --9]WRITE A QUERY TO DISPLAY DEPARTMENT NO IF THERE ARE ATLEAST 3 EMP IN EACH DEPARTMENT WHOSE NAME HAS CHAR 'A' OR 'S' ?
SQL> 
SQL> 
SQL> SELECT COUNT(*), DEPTNO
  2  FROM EMP
  3  WHERE ENAME LIKE '%A% OR ENAME LIKE '%S%'
  4  GROUP BY DEPTNO
  5  HAVING COUNT(*) >=3;
ERROR:
ORA-01756: quoted string not properly terminated 


