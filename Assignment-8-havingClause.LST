SQL> --5] WRITE A QUERY TO DISPLAY JOB AND MAXIMUM SALARY OF EMPLOYEE IN EACH JOB IF THE MAX SALARY EXCEEPS 2600 ?
SQL> 
SQL> SELECT COUNT(*), DEPTNO
  2  FROM EMP
  3  WHERE JOB ='
  4  
SQL> 
SQL> 
SQL> SELECT MAX(SAL),JOB
  2  FROM EMP
  3  GROUP BY JOB
  4  HAVING MAX(SAL) >2600;

  MAX(SAL) JOB                                                                  
---------- ---------                                                            
      5000 PRESIDENT                                                            
      2975 MANAGER                                                              
      3000 ANALYST                                                              

