SQL> --------------------------------------SUB QUERY OPERATOR----------------------------------------
SQL> 
SQL> --1] WRITE A QUERY TO DISPLAY NAME OF THE EMPLOYEES EARNING SALARY MORE THAN THE SALESMAN ?
SQL> 
SQL> SELECT ENAME
  2  FROM EMP
  3  WHERE SAL > ALL (SELECT SAL FROM EMP WHERE JOB='SALESMAN');

ENAME                                                                                               
----------                                                                                          
JONES                                                                                               
BLAKE                                                                                               
CLARK                                                                                               
SCOTT                                                                                               
KING                                                                                                
FORD                                                                                                

6 rows selected.

SQL> 
SQL> -----------------------------------------------------------------------------------------------
SQL> 
SQL> --2] WRITE A QUERY TO DISPLAY DETAILS OF THE EMPLOYEES HIRED AFTER ALL THE CLERKS ?
SQL> 
SQL> SELECT *
  2  FROM EMP
  3  WHERE HIREDATE > ALL (SELECT HIREDATE FROM EMP WHERE JOB ='CLERK');

no rows selected

SQL> 
SQL> -----------------------------------------------------------------------------------------------
SQL> 
SQL> --3] WRITE A QUERY TO DISPLAY NAME AND SALARY FOR ALL THE EMPLOYEES IF THEY ARE EARNING LESS THAN ATLEAST A MANAGER ?
SQL> 
SQL> SELECT ENAME, SAL
  2  FROM EMP
  3  WHERE SAL > ANY(SELECT SAL FROM EMP WHERE JOB ='MANAGER');

ENAME             SAL                                                                               
---------- ----------                                                                               
KING             5000                                                                               
FORD             3000                                                                               
SCOTT            3000                                                                               
JONES            2975                                                                               
BLAKE            2850                                                                               

SQL> 
SQL> -----------------------------------------------------------------------------------------------
SQL> 
SQL> --4] WRITE A QUERY TO DISPLAY NAME AND HIREDATE OF EMPLOYEES HIRED BEFORE ALL THE MANAGERS ?
SQL> 
SQL> SELECT ENAME, HIREDATE
  2  FROM EMP
  3  WHERE HIREDATE < ALL (SELECT HIREDATE FROM EMP WHERE JOB='MANAGER');

ENAME      HIREDATE                                                                                 
---------- ---------                                                                                
SMITH      17-DEC-80                                                                                
ALLEN      20-FEB-81                                                                                
WARD       22-FEB-81                                                                                

SQL> 
SQL> -----------------------------------------------------------------------------------------------
SQL> 
SQL> --5] WRITE A QUERY TO DISPLAY NAME OF THE EMPLOYEES HIRED AFTER ALL THE MANAGERS AND EARNING SALARY MORE THAN ALL THE CLERKS ?
SQL> 
SQL> SELECT ENAME
  2  FROM EMP
  3  WHERE HIREDATE > ALL (SELECT HIREDATE FROM EMP WHERE JOB='MANAGER') AND
  4  SAL > ALL (SELECT SAL FROM EMP WHERE JOB ='CLERK');

ENAME                                                                                               
----------                                                                                          
SCOTT                                                                                               
KING                                                                                                
TURNER                                                                                              
FORD                                                                                                

