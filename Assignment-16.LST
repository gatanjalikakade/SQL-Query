SQL> 
SQL> --1]WRITE A QUERY TO DISPLAY NAME OF THE EMPLOYEE AND HIS MANAGER'S NAME IF EMPLOYEE IS WORKING AS CLERK ?
SQL> 
SQL> SELECT E1.ENAME, E2.ENAME
  2  FROM EMP E1, EMP E2
  3  WHERE E1.MGR= E2.EMPNO AND E1.JOB='CLERK';

ENAME      ENAME                                                                                    
---------- ----------                                                                               
SMITH      FORD                                                                                     
ADAMS      SCOTT                                                                                    
JAMES      BLAKE                                                                                    
MILLER     CLARK                                                                                    

SQL> 
SQL> -----------------------------------------------------------------------------------------------
SQL> 
SQL> 
SQL> --2]WRITE A QUERY TO DISPLAY NAME OF THE EMPLOYEE AND MANAGER'S DESIGNARION IF MANAGER WORKS IN DEPT 10 OR 20 ?
SQL> 
SQL> SELECT E1.ENAME, E2.JOB
  2  FROM EMP E1, EMP E2
  3  WHERE E1.MGR= E2.EMPNO AND E2.DEPTNO IN (10,20);

