SQL> --4]WRITE A QUERY TO DISPLAY NAME AND MANAGERS COMMISION IF EMPLOYEE WORK AS SALESMAN AND MANAGER WORKS IN DEPARTMENT 30 ?
SQL> 
SQL> SELECT E1.ENAME, E2.COMM
