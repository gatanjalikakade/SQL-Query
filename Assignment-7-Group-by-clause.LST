SQL> 
SQL> 
SQL> --1] WRITE A QUERY TO DISPLAY NUMBER OF EMPLOYEES WHO ARE WORKING IN EACH JOB ?
SQL> 
SQL> SELECT COUNT(*),JOB
  2  FROM EMP
  3  GROUP BY JOB;

  COUNT(*) JOB                                                                                      
---------- ---------                                                                                
         4 CLERK                                                                                    
         4 SALESMAN                                                                                 
         1 PRESIDENT                                                                                
         3 MANAGER                                                                                  
         2 ANALYST                                                                                  

SQL> 
SQL> 
SQL> -----------------------------------------------------------------------------------------------
SQL> 
SQL> --2]WRITE A QUERY TO DISPLAY NUMBER OF EMPLOYEES WHO ARE GETTING SALARY MORE THAN 2000 ?
SQL> 
SQL> SELECT COUNT(*)
  2  FROM EMP
  3  WHERE SAL >2000;

  COUNT(*)                                                                                          
----------                                                                                          
         6                                                                                          

SQL> 
SQL> 
SQL> -----------------------------------------------------------------------------------------------
SQL> 
SQL> --3]WRITE A QUERY TO DISPLAY  NUMBER OF EMPLOYEES WHO HIRED AFTER 1980 IN EACH DEPARTMENT ?
SQL> 
SQL> SELECT COUNT(*), DEPTNO
  2  FROM EMP
  3  WHERE HIREDATE >'31-DEC-1980'
  4  GROUP BY DEPTNO;

  COUNT(*)     DEPTNO                                                                               
---------- ----------                                                                               
         6         30                                                                               
         4         20                                                                               
         3         10                                                                               

SQL> 
SQL> -----------------------------------------------------------------------------------------------
SQL> 
SQL> --4]WRITE A QUERY TO DISPLAY NUMBER OF EMPLOYEES WORKING IN EACH DEPARTMENT EXCEPT PRESIDENT ?
SQL> 
SQL> SELECT COUNT(*),DEPTNO
  2  FROM EMP
  3  WHERE JOB NOT IN 'PRESIDENT'
  4  GROUP BY DETPNO;
GROUP BY DETPNO
