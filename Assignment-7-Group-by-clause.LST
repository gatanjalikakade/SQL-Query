SQL> --7]WRITE A QUERY TO DISPLAY AVERAGE SALARY NEEDED TO PAY ALL THE EMPLOYEES IN EACH DEPARTMENT EXCLUDING THE EMPLOYEES OF DEPTNO 20 ?
SQL> 
SQL> 
SQL> SELECT AVG(SAL),DEPTNO
  2  FROM EMP
  3  WHERE DEPTNO NOT IN 20
  4  GROUP BY DEPTNO;

  AVG(SAL)     DEPTNO                                                                               
---------- ----------                                                                               
1566.66667         30                                                                               
2916.66667         10                                                                               

SQL> 
SQL> -----------------------------------------------------------------------------------------------
SQL> 
SQL> --8]WRITE A QUERY TO DISPLAY NUMBER OF EMPLOYEES HAVING CHARACTER 'A' IN THEIR NAMES IN EACH JOB ?
SQL> 
SQL> SELECT COUNT(*),JOB
  2  FROM EMP
  3  WHERE ENAME LIKE '%A%'
  4  GROUP BY JOB;

  COUNT(*) JOB                                                                                      
---------- ---------                                                                                
         3 SALESMAN                                                                                 
         2 CLERK                                                                                    
         2 MANAGER                                                                                  

SQL> 
SQL> 
SQL> -----------------------------------------------------------------------------------------------
SQL> 
SQL> --9]WRITE A QUERY TO DISPLAY NUMBER OF EMPLOYEES AND AVG SALARY NEEDED TO PAY THE EMPLOYEES WHOSE SALARY IN GREATER THAN 2000 IN EACH DEPARTMENT ?
SQL> 
SQL> SELECT COUNT(*), AVG(SAL), DEPTNO
  2  FROM EMP
  3  WHERE SAL >2000
  4  GROUP BY DEPTNO;

  COUNT(*)   AVG(SAL)     DEPTNO                                                                    
---------- ---------- ----------                                                                    
         1       2850         30                                                                    
         3 2991.66667         20                                                                    
         2       3725         10                                                                    

SQL> 
SQL> -----------------------------------------------------------------------------------------------
SQL> 
SQL> --10]WRITE A QUERY TO DISPLAY TOTAL SALARY NEEDED TO PAY AND NUMBER OF SALESMAN IN EACH DEPARTMENT ?
SQL> 
SQL> SELECT SUM(SAL), DEPTNO
  2  FROM EMP
  3  WHERE JOB IN 'SALESMAN'
  4  GROUP BY DEPTNO;

  SUM(SAL)     DEPTNO                                                                               
---------- ----------                                                                               
      5600         30                                                                               

SQL> 
