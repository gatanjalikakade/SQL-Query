  2  FROM EMP
  3  GROUP BY JOB;

  COUNT(*)   MAX(SAL) JOB                                                                           
---------- ---------- ---------                                                                     
         4       1300 CLERK                                                                         
         4       1600 SALESMAN                                                                      
         1       5000 PRESIDENT                                                                     
         3       2975 MANAGER                                                                       
         2       3000 ANALYST                                                                       

SQL> 
