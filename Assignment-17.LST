SQL> --3] WRITE A QUERY TO DISPLAY ENAME EMPLOYEE SALARY MANAGERS NAME, MANAGER'S SALARY ALONG WOTH EMPLOYEE DNAME IF EMPLOYEE EARNS MORE THAN MANAGER ?
SQL> 
SQL> SELECT E1.ENAME, E1.SAL, E2.ENAME,E2.SAL, D1.DNAME
  2  FROM EMP E1, EMP E2, DEPT D1
  3  WHERE E1.MGR=E2.EMPNO AND E1.DEPTNO= D1.DEPTNO AND E1.SAL > E2.SAL;

ENAME             SAL ENAME             SAL DNAME                                                   
---------- ---------- ---------- ---------- --------------                                          
SCOTT            3000 JONES            2975 RESEARCH                                                
FORD             3000 JONES            2975 RESEARCH                                                

