SQL> --1] WRITE A QUERY TO DISPLAY ENAME AND MANAGERS NAME AND EMP LOCATION FOR THE EMPLOYEE WORKING AS CLERK ?
SQL> 
SQL> 
SQL> SELECT E1.ENAME, E2.ENAME, D1.LOC
  2  FROM EMP E1, EMP E2, DEPT D1
  3  WHERE E1.MGR= E2.EMPNO AND E1.DEPTNO= D1.DEPTNO AND E1.JOB='CLERK' ;

ENAME      ENAME      LOC                                                                           
---------- ---------- -------------                                                                 
SMITH      FORD       DALLAS                                                                        
ADAMS      SCOTT      DALLAS                                                                        
JAMES      BLAKE      CHICAGO                                                                       
MILLER     CLARK      NEW YORK                                                                      

SQL> 
SQL> 
SQL> -----------------------------------------------------------------------------------------------
SQL> 
